{
  "id": "boltechSalesMarketing",
  "name": "Boltech | Ventas ↔ Mercadeo | apoyo y cierre",
  "active": false,
  "nodes": [
    {
      "id": "receive",
      "name": "Recibir solicitud del RSI",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "boltech-sales-marketing",
      "parameters": {
        "httpMethod": "POST",
        "path": "boltech-sales-marketing",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "boltechInteragentHeader",
          "name": "Boltech interagent local"
        }
      }
    },
    {
      "id": "decide",
      "name": "Directora asigna ruta y alternativa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://boltech-group.vercel.app/api/partners?action=interagent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Boltech-Signature",
              "value": "={{ $json.headers[\"x-boltech-signature\"] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 25000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": false
    },
    {
      "id": "branch",
      "name": "Apoyo o decisión de Dirección",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "target",
              "leftValue": "={{ $json.to }}",
              "rightValue": "marketing-director",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "marketing",
      "name": "Mercadeo entrega apoyo al RSI solicitante",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -140
      ],
      "parameters": {
        "jsCode": "return [{json:{...$json,materialPersisted:!!$json.material,notificationDelivered:false}}];"
      }
    },
    {
      "id": "director",
      "name": "Dirección recibe cierre o bloqueo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        160
      ],
      "parameters": {
        "jsCode": "return [{json:{...$json,directorActionPending:$json.success===true,notificationDelivered:false, instruction:'RSI-03 informa a Directora; Directora verifica y comunica a Ricardo. Conservar esta ejecución como evidencia; no contabilizar cobro por el aviso.'}}];"
      }
    },
    {
      "id": "response",
      "name": "Devolver resultado y conservar ejecución",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1080,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.success ? 200 : 400 }}"
        }
      }
    }
  ],
  "connections": {
    "Recibir solicitud del RSI": {
      "main": [
        [
          {
            "node": "Directora asigna ruta y alternativa",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Directora asigna ruta y alternativa": {
      "main": [
        [
          {
            "node": "Apoyo o decisión de Dirección",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Apoyo o decisión de Dirección": {
      "main": [
        [
          {
            "node": "Mercadeo entrega apoyo al RSI solicitante",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Dirección recibe cierre o bloqueo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mercadeo entrega apoyo al RSI solicitante": {
      "main": [
        [
          {
            "node": "Devolver resultado y conservar ejecución",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dirección recibe cierre o bloqueo": {
      "main": [
        [
          {
            "node": "Devolver resultado y conservar ejecución",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/El_Salvador",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "executionTimeout": 60
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
